@model IEnumerable<FitLogApp.Models.Exercise>

@{
    ViewData["Title"] = "All Exercises";
    var exerciseList = Model ?? Enumerable.Empty<FitLogApp.Models.Exercise>();
}

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">Exercise Library</h3>
            <p class="text-secondary small mb-0">All logged movements across your active workout routines.</p>
        </div>
    </div>

    <div class="saas-card">
        @if (!exerciseList.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-activity fs-2 text-secondary"></i>
                <h5 class="fw-bold text-dark mt-2 mb-1">No exercises recorded</h5>
                <p class="text-secondary small mb-0">Open any routine from the sidebar to start logging exercises.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="text-secondary small">
                        <tr>
                            <th class="ps-3 border-0">EXERCISE</th>
                            <th class="border-0">ROUTINE</th>
                            <th class="border-0 text-center">SETS</th>
                            <th class="border-0 text-center">REPS</th>
                            <th class="border-0 text-center">WEIGHT</th>
                            <th class="border-0 text-center">STATUS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ex in exerciseList)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-dark">@ex.Name</td>
                                <td>
                                    <span class="badge bg-light text-secondary border rounded-pill px-3 py-1">
                                        @(ex.WorkoutRoutine?.Name ?? "Unassigned")
                                    </span>
                                </td>
                                <td class="text-center font-monospace">@ex.Sets</td>
                                <td class="text-center font-monospace">@ex.Reps</td>
                                <td class="text-center font-monospace">@ex.Weight kg</td>
                                <td class="text-center">
                                    <span class="badge @(ex.isCompleted ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary") rounded-pill px-3 py-1">
                                        @(ex.isCompleted ? "Done" : "Pending")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>