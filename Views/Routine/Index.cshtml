@model IEnumerable<FitLogApp.Models.WorkoutRoutine>

@{
    ViewData["Title"] = "Workout Dashboard";
    var routines = Model ?? Enumerable.Empty<FitLogApp.Models.WorkoutRoutine>();
    var totalRoutines = routines.Count();
    var totalExercises = routines.Sum(r => r.Exercises?.Count ?? 0);
}

<div class="container-fluid p-0">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">Workout Dashboard</h3>
            <p class="text-secondary small mb-0">Track today's lifts, active routines, and weekly volume.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Routine" asp-action="Create" class="btn btn-dark rounded-pill px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm text-decoration-none">
                <i class="bi bi-plus-lg"></i> New Routine
            </a>
        </div>
    </div>

    <!-- Upper Metrics Row (Charts + Dynamic Stats) -->
    <div class="row g-4 mb-4">
        <!-- Weekly Muscle Distribution / Bar Chart Widget -->
        <div class="col-lg-7">
            <div class="saas-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h6 class="fw-bold mb-0 text-dark">Weekly Muscle Split</h6>
                    <span class="text-primary small fw-bold bg-primary-subtle px-3 py-1 rounded-pill">Active Schedule</span>
                </div>
                
                <!-- Bar Indicator Columns -->
                <div class="d-flex justify-content-between align-items-end pt-3 px-2" style="height: 160px;">
                    @foreach (var day in new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" })
                    {
                        var hasRoutine = routines.Any(r => r.DaysOfWeek.StartsWith(day, StringComparison.OrdinalIgnoreCase));
                        <div class="text-center d-flex flex-column align-items-center gap-2">
                            <div class="rounded-pill bg-light" style="width: 38px; height: 110px; position: relative;">
                                @if (hasRoutine)
                                {
                                    <div class="bg-primary rounded-pill position-absolute bottom-0 w-100" style="height: 75%;"></div>
                                }
                            </div>
                            <span class="text-secondary small">@day</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Dynamic Metrics & Quick Stats -->
        <div class="col-lg-5">
            <div class="saas-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0 text-dark">Routine Summary</h6>
                    <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1">Live Tracking</span>
                </div>
                
                <div class="d-flex align-items-center justify-content-around py-3">
                    <div class="text-center">
                        <div class="rounded-circle border border-4 border-primary p-3 d-inline-flex align-items-center justify-content-center mb-2" style="width: 75px; height: 75px;">
                            <span class="fw-bold fs-4 text-dark">@totalRoutines</span>
                        </div>
                        <div class="small text-secondary fw-medium">Active Routines</div>
                    </div>
                    <div class="text-center">
                        <div class="rounded-circle border border-4 border-info p-3 d-inline-flex align-items-center justify-content-center mb-2" style="width: 75px; height: 75px;">
                            <span class="fw-bold fs-4 text-dark">@totalExercises</span>
                        </div>
                        <div class="small text-secondary fw-medium">Total Exercises</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Routines List / Empty State -->
    <div class="saas-card">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold text-dark mb-0">Active Routines</h6>
            <span class="text-secondary small">@totalRoutines routine(s) configured</span>
        </div>

        @if (!routines.Any())
        {
            <div class="text-center py-5">
                <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center p-3 mb-3 text-secondary" style="width: 60px; height: 60px;">
                    <i class="bi bi-calendar2-plus fs-3"></i>
                </div>
                <h5 class="fw-bold text-dark mb-1">No routines created yet</h5>
                <p class="text-secondary small mb-3">Build your workout splits and attach exercises to track sets and volume.</p>
                <a asp-controller="Routine" asp-action="Create" class="btn btn-dark rounded-pill px-4 py-2 fw-semibold text-decoration-none">
                    <i class="bi bi-plus-lg me-1"></i> Create First Routine
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="text-secondary small">
                        <tr>
                            <th class="ps-3 border-0">ROUTINE</th>
                            <th class="border-0">TARGET MUSCLE</th>
                            <th class="border-0">SCHEDULE</th>
                            <th class="border-0 text-center">EXERCISES</th>
                            <th class="border-0 text-end pe-3">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var routine in routines)
                        {
                            var exerciseCount = routine.Exercises?.Count ?? 0;
                            <tr>
                                <td class="ps-3">
                                    <span class="fw-bold text-dark">@routine.Name</span>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">@routine.TargetMuscle</span>
                                </td>
                                <td class="text-secondary small">@routine.DaysOfWeek</td>
                                <td class="text-center">
                                    <span class="badge bg-light text-secondary rounded-pill border px-3 py-1">
                                        @exerciseCount @(exerciseCount == 1 ? "Exercise" : "Exercises")
                                    </span>
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-controller="Routine" asp-action="Details" asp-route-id="@routine.ID" class="btn btn-sm btn-light rounded-pill px-3 fw-medium text-decoration-none border">
                                        View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>